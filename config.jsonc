{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
            "color": {
        "1": "0"
    }
    },
    "display": {
    	"separator": "",
},
    "modules": [
          "break",
          "break",
	
	  {
	  "type":"title",
	  "format":"{6}{7}{8}",
	  "key":"󱩊    ",
	  "keyColor":"33",
	  "output":"33",
	  },
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "33",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "key": " ├ 󰏖 ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "33", 
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "33", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "33",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "33",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "33", 
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "33",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "33", 
        },
        "break",
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7} GHz",
            "key": "CPU  ",
            "keyColor": "33",
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz",            
            "key": " ├ 󰢮 ",
            "keyColor": "33",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "33",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "33",
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "33",
        },
        {
            "type": "monitor",
            "key": " └  ",
            "keyColor": "33",
        },

        ]
}
